{
  "name": "storyboard-studio",
  "version": "1.0.0",
  "description": "JSON-first 3D storyboard editor for photographers, with an agent skill",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ackermancxy/storyboard-studio.git"
  },
  "homepage": "https://github.com/Ackermancxy/storyboard-studio#readme",
  "bugs": {
    "url": "https://github.com/Ackermancxy/storyboard-studio/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node serve.mjs 5219 dist",
    "setup": "node scripts/install.mjs",
    "check": "tsc --noEmit && vitest run && npm run check:poses",
    "analyze": "node tools/pose-analysis/analyze.mjs",
    "analyze:presets": "node tools/pose-analysis/analyze.mjs --presets --model mikoto",
    "check:poses": "node tools/pose-analysis/analyze.mjs --presets --model mikoto --strict --quiet",
    "test:pose": "node --test tools/pose-analysis/analyze.selftest.mjs"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "lil-gui": "0.21.0",
    "three": "0.186.1",
    "three-stdlib": "^2.36.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
